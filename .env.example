# ---- Runtime ----
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# ---- Database ----
DATABASE_URL=postgres://app:app_dev_password@localhost:5432/aidocs
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=aidocs

# ---- AI provider ----
# LLM_PROVIDER=openai | mock   (mock = deterministic, no API key needed)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Prompt / RAG config ----
PROMPT_VERSION=v1
RAG_TOP_K=5
RAG_MIN_SCORE=0.2
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=50

# ---- Cost & abuse control ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
MAX_UPLOAD_MB=10
